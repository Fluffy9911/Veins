  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },
  "license": "Apache-2.0",
  "icon": "assets/veins/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.fluffy.fabric.VeinsModFabric"
